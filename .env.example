# Credencial del agente en el workspace de demostración de Ambiguous.
# Permisos necesarios: identidad, lectura de tareas, creación/lectura de documentos.
AMBIGUOUS_API_KEY=ak_xxx

# pnpm run setup genera un token aleatorio de 64 caracteres para el core local.
CORE_INGEST_TOKEN=

# Opcional: directorio privado de persistencia (ruta absoluta recomendada).
# DEJAVU_DATA_DIR=/ruta/privada/dejavu
